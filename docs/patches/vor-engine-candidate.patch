+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "core/VorAsyncReceiver.h"
+#include <array>
+#include <complex>
+#include <cstddef>
+#include <cstdint>
+namespace dsdr::core {
+// Engine-thread only. The owner must quiesce the producer before detaching or
+// changing configuration and must keep the receiver alive until then.
+class VorEngineTap final {
+public:
+    explicit VorEngineTap(VorAsyncReceiver& receiver) : m_receiver(receiver) {}
+    // Raw complex input, integer 48 kHz multiples, at least 96 kHz. Tune is
+    // relative to source centre. Retains approximately +/- 12 kHz at output.
+    bool configure(unsigned inputRate, double tuneHz);
+    void reset() noexcept;
+    void process(const dsp::Complex* samples, std::size_t count) noexcept;
+    std::uint64_t submitted() const noexcept { return m_submitted; }
+private:
+    static constexpr std::size_t taps=193, chunk=512;
+    VorAsyncReceiver& m_receiver;
+    std::array<float,taps> m_coeff{};
+    std::array<std::complex<float>,taps> m_ring{};
+    std::array<std::complex<float>,chunk> m_output{};
+    unsigned m_rate=0,m_decimation=0,m_phase=0;
+    std::size_t m_pos=0,m_out=0;
+    double m_osc=0,m_step=0;
+    std::uint64_t m_submitted=0;
+};
+}
diff --git a/src/core/VorEngineTap.cpp b/src/core/VorEngineTap.cpp
new file mode 100644
--- /dev/null
+++ b/src/core/VorEngineTap.cpp
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/VorEngineTap.h"
+#include <cmath>
+namespace dsdr::core {
+namespace { constexpr double pi=3.14159265358979323846; }
+bool VorEngineTap::configure(unsigned rate,double tune) {
+    m_rate=0;
+    if(rate<96000 || rate>384000 || rate%48000 || !std::isfinite(tune) || std::abs(tune)+15000>=rate/2.) return false;
+    m_rate=rate; m_decimation=rate/48000; m_step=2*pi*tune/rate;
+    // Blackman FIR, 14 kHz cutoff; unity DC gain.
+    double sum=0;
+    for(std::size_t i=0;i<taps;++i) {
+        const double k=double(i)-double(taps-1)/2;
+        const double h=k==0 ? 28000./rate : std::sin(2*pi*14000*k/rate)/(pi*k);
+        const double w=.42-.5*std::cos(2*pi*i/(taps-1))+.08*std::cos(4*pi*i/(taps-1));
+        m_coeff[i]=float(h*w); sum+=m_coeff[i];
+    }
+    for(auto& c:m_coeff) c=float(c/sum);
+    reset(); return true;
+}
+void VorEngineTap::reset() noexcept {
+    m_ring.fill({}); m_pos=m_out=m_phase=0; m_osc=0; m_receiver.discontinuity();
+}
+void VorEngineTap::process(const dsp::Complex* samples,std::size_t count) noexcept {
+    if(!m_rate || !samples) return;
+    for(std::size_t n=0;n<count;++n) {
+        m_ring[m_pos]=samples[n]*dsp::Complex(float(std::cos(m_osc)),float(-std::sin(m_osc)));
+        m_osc+=m_step; if(m_osc>pi) m_osc-=2*pi; else if(m_osc < -pi) m_osc+=2*pi;
+        m_pos=(m_pos+1)%taps;
+        if(++m_phase<m_decimation) continue;
+        m_phase=0; dsp::Complex sum{}; std::size_t pos=m_pos;
+        for(std::size_t j=0;j<taps;++j) { pos=pos?pos-1:taps-1; sum+=m_ring[pos]*m_coeff[j]; }
+        m_output[m_out++]=sum;
+        if(m_out==chunk) { auto result=m_receiver.submitIq(m_output.data(),m_out); if(result==AsyncIqDecoder::SubmitResult::Accepted) ++m_submitted; m_out=0; }
+    }
+}
+}
