# Verify the actual install rules and detect a missing notice using only a
# uniquely named test directory inside the build tree.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(stage "${DSDR_BINARY_DIR}/onair-notices-test-${suffix}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${DSDR_BINARY_DIR}"
    --prefix "${stage}" --component OnAirTerms
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Notice install failed: ${output} ${error}")
endif()
if(DSDR_APPLE)
    set(base "${stage}/decodium-sdr.app/Contents/Resources")
else()
    set(base "${stage}/share/decodium-sdr")
endif()
function(check_identical source installed result_name)
    if(NOT EXISTS "${installed}")
        set(${result_name} FALSE PARENT_SCOPE)
        return()
    endif()
    file(SHA256 "${source}" expected)
    file(SHA256 "${installed}" actual)
    if(expected STREQUAL actual)
        set(${result_name} TRUE PARENT_SCOPE)
    else()
        set(${result_name} FALSE PARENT_SCOPE)
    endif()
endfunction()
foreach(name ADDITIONAL-TERMS.md NOTICE.md THIRD_PARTY.md)
    check_identical("${DSDR_SOURCE_DIR}/docs/decoders/acars-onair/${name}" "${base}/OnAir/${name}" valid)
    if(NOT valid)
        message(FATAL_ERROR "Missing or altered OnAir notice: ${name}")
    endif()
endforeach()
foreach(name LICENSE THIRD_PARTY_LICENSES)
    check_identical("${DSDR_SOURCE_DIR}/${name}" "${base}/licenses/${name}" valid)
    if(NOT valid)
        message(FATAL_ERROR "Missing or altered project notice: ${name}")
    endif()
endforeach()
file(REMOVE "${base}/OnAir/NOTICE.md")
check_identical("${DSDR_SOURCE_DIR}/docs/decoders/acars-onair/NOTICE.md" "${base}/OnAir/NOTICE.md" valid)
if(valid)
    message(FATAL_ERROR "Negative control failed to detect a missing notice")
endif()
file(REMOVE_RECURSE "${stage}")
