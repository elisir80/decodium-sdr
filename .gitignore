# Dipendenze compilate a mano in locale quando il pacchetto di sistema non è
# utilizzabile. NON è vendoring: il codice di terze parti vendorizzato va
# versionato, con licenza e voce in THIRD_PARTY_LICENSES (CONSTITUTION §3).
# Questi sono solo artefatti di build della macchina di sviluppo.
/third_party/soapysdr/

# La libreria del ColibriNANO è del costruttore: la si tiene qui perché CMake
# la trovi da sé a ogni build, ma non è nostra da ridistribuire.
/third_party/colibrinano/

# RNNoise: sorgente e pesi del modello arrivano da monte (BSD-3), non da noi.
#   git clone --depth 1 https://github.com/xiph/rnnoise third_party/rnnoise
#   cd third_party/rnnoise && ./download_model.sh
/third_party/rnnoise/

# VST3 SDK: MIT dalla 3.8.1 in poi — compatibile senza riserve con GPL-3.0.
# Duecentoquaranta megabyte non si versionano, si clonano:
#   git clone --depth 1 --recurse-submodules --shallow-submodules #       https://github.com/steinbergmedia/vst3sdk.git third_party/vst3sdk
/third_party/vst3sdk/

# Pacchetti di release: si costruiscono, non si versionano. Un archivio da
# settanta megabyte resta nella storia di git per sempre, anche dopo essere
# stato cancellato.
/decodium-sdr-*.zip
/decodium-sdr-*.dmg
/decodium-sdr-*.AppImage
/staging/
/decodium-sdr/
/decodium-sdr-windows-x86_64/
/decodium-sdr-linux-x86_64/
/decodium-sdr-macos-arm64/

# Registrazioni IQ: pesano e non appartengono al repository
*.wav
*.sigmf-data
*.sigmf-meta
