# Generated by CMake for the macOS install tree.
# `rigctld` is a process, not a linked dependency of the GUI: copy it and its
# two non-system libraries explicitly so a downloaded DMG can use Hamlib.

set(dsdr_app "${CMAKE_INSTALL_PREFIX}/decodium-sdr.app")
set(dsdr_frameworks "${dsdr_app}/Contents/Frameworks")
set(dsdr_hamlib_bin "${dsdr_app}/Contents/Resources/hamlib/bin")
set(dsdr_rigctld "${dsdr_hamlib_bin}/rigctld")
set(dsdr_hamlib "${dsdr_frameworks}/@DSDR_HAMLIB_BASENAME@")
set(dsdr_libusb "${dsdr_frameworks}/@DSDR_HAMLIB_LIBUSB_BASENAME@")

foreach(dsdr_required
        "@DSDR_RIGCTLD_EXECUTABLE@"
        "@DSDR_HAMLIB_LIBRARY@"
        "@DSDR_HAMLIB_LIBUSB_LIBRARY@")
    if(NOT EXISTS "${dsdr_required}")
        message(FATAL_ERROR "Dipendenza Hamlib scomparsa prima dell'installazione: ${dsdr_required}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${dsdr_hamlib_bin}" "${dsdr_frameworks}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "@DSDR_RIGCTLD_EXECUTABLE@" "${dsdr_rigctld}"
    RESULT_VARIABLE dsdr_copy_result)
if(NOT dsdr_copy_result EQUAL 0)
    message(FATAL_ERROR "Copia di rigctld nel bundle macOS fallita")
endif()
file(CHMOD "${dsdr_rigctld}"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "@DSDR_HAMLIB_LIBRARY@" "${dsdr_hamlib}"
    RESULT_VARIABLE dsdr_hamlib_copy_result)
if(NOT dsdr_hamlib_copy_result EQUAL 0)
    message(FATAL_ERROR "Copia di libhamlib nel bundle macOS fallita")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "@DSDR_HAMLIB_LIBUSB_LIBRARY@" "${dsdr_libusb}"
    RESULT_VARIABLE dsdr_libusb_copy_result)
if(NOT dsdr_libusb_copy_result EQUAL 0)
    message(FATAL_ERROR "Copia di libusb per Hamlib nel bundle macOS fallita")
endif()

function(dsdr_rewrite_dependency binary basename replacement)
    execute_process(COMMAND otool -L "${binary}"
        RESULT_VARIABLE dsdr_otool_result
        OUTPUT_VARIABLE dsdr_otool_output
        ERROR_VARIABLE dsdr_otool_error)
    if(NOT dsdr_otool_result EQUAL 0)
        message(FATAL_ERROR "otool non riesce a leggere ${binary}: ${dsdr_otool_error}")
    endif()
    string(REGEX MATCH "[^ \t\n]+/${basename}" dsdr_source "${dsdr_otool_output}")
    if(dsdr_source)
        execute_process(COMMAND "@CMAKE_INSTALL_NAME_TOOL@"
            -change "${dsdr_source}" "${replacement}" "${binary}"
            RESULT_VARIABLE dsdr_rewrite_result
            ERROR_VARIABLE dsdr_rewrite_error)
        if(NOT dsdr_rewrite_result EQUAL 0)
            message(FATAL_ERROR
                "Riscrittura dipendenza Hamlib fallita (${binary}): ${dsdr_rewrite_error}")
        endif()
    endif()
endfunction()

# Da Contents/Resources/hamlib/bin a Contents/Frameworks ci sono tre livelli.
dsdr_rewrite_dependency("${dsdr_rigctld}" "@DSDR_HAMLIB_BASENAME@"
                        "@DSDR_HAMLIB_LOADER_PATH@/../../../Frameworks/@DSDR_HAMLIB_BASENAME@")
dsdr_rewrite_dependency("${dsdr_rigctld}" "@DSDR_HAMLIB_LIBUSB_BASENAME@"
                        "@DSDR_HAMLIB_LOADER_PATH@/../../../Frameworks/@DSDR_HAMLIB_LIBUSB_BASENAME@")
dsdr_rewrite_dependency("${dsdr_hamlib}" "@DSDR_HAMLIB_LIBUSB_BASENAME@"
                        "@DSDR_HAMLIB_LOADER_PATH@/@DSDR_HAMLIB_LIBUSB_BASENAME@")

execute_process(COMMAND "@CMAKE_INSTALL_NAME_TOOL@"
    -id "@DSDR_HAMLIB_LOADER_PATH@/@DSDR_HAMLIB_BASENAME@" "${dsdr_hamlib}"
    RESULT_VARIABLE dsdr_hamlib_id_result ERROR_VARIABLE dsdr_hamlib_id_error)
if(NOT dsdr_hamlib_id_result EQUAL 0)
    message(FATAL_ERROR "ID di libhamlib non aggiornato: ${dsdr_hamlib_id_error}")
endif()
execute_process(COMMAND "@CMAKE_INSTALL_NAME_TOOL@"
    -id "@DSDR_HAMLIB_LOADER_PATH@/@DSDR_HAMLIB_LIBUSB_BASENAME@" "${dsdr_libusb}"
    RESULT_VARIABLE dsdr_libusb_id_result ERROR_VARIABLE dsdr_libusb_id_error)
if(NOT dsdr_libusb_id_result EQUAL 0)
    message(FATAL_ERROR "ID di libusb Hamlib non aggiornato: ${dsdr_libusb_id_error}")
endif()

message(STATUS "Bundled rigctld/Hamlib in: ${dsdr_hamlib_bin}")
