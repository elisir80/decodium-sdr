# Generated by CMake for the macOS install tree.
#
# Soapy modules are runtime plugins. Qt deploy sees neither the modules nor the
# vendor libraries below them, so resolve this graph independently and rewrite
# every non-system link to Contents/Frameworks. `fixup_bundle()` is deliberately
# not used: it rescans the full Qt bundle and is confused by Qt's QML symlinks.

set(dsdr_app "${CMAKE_INSTALL_PREFIX}/decodium-sdr.app")
set(dsdr_executable "${dsdr_app}/Contents/MacOS/decodium-sdr")
set(dsdr_frameworks "${dsdr_app}/Contents/Frameworks")
set(dsdr_modules "${dsdr_app}/Contents/lib/SoapySDR/modules0.8")
set(dsdr_sources "@DSDR_SOAPY_BUNDLED_MODULE_FILES@")
set(dsdr_search_dirs "@DSDR_SOAPY_BUNDLE_SEARCH_PATHS@")
set(dsdr_runtime_dirs "@DSDR_SOAPY_BUNDLE_RUNTIME_DIRS@")
set(dsdr_install_name_tool "@CMAKE_INSTALL_NAME_TOOL@")

if(NOT EXISTS "${dsdr_executable}")
    message(FATAL_ERROR "Bundle DECODIUM SDR non trovato: ${dsdr_executable}")
endif()
if(NOT dsdr_sources)
    message(FATAL_ERROR "Nessun modulo SoapySDR configurato per il bundle macOS")
endif()
if(NOT EXISTS "${dsdr_install_name_tool}")
    message(FATAL_ERROR "install_name_tool non trovato: ${dsdr_install_name_tool}")
endif()

function(dsdr_copy_binary source destination)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${destination}"
        RESULT_VARIABLE dsdr_copy_result
        OUTPUT_VARIABLE dsdr_copy_output
        ERROR_VARIABLE dsdr_copy_error)
    if(NOT dsdr_copy_result EQUAL 0)
        message(FATAL_ERROR
            "Copia binario macOS fallita (${source} -> ${destination}): "
            "${dsdr_copy_output}${dsdr_copy_error}")
    endif()
endfunction()

function(dsdr_change_link binary old new)
    execute_process(
        COMMAND "${dsdr_install_name_tool}" -change "${old}" "${new}" "${binary}"
        RESULT_VARIABLE dsdr_change_result
        OUTPUT_VARIABLE dsdr_change_output
        ERROR_VARIABLE dsdr_change_error)
    if(NOT dsdr_change_result EQUAL 0)
        message(FATAL_ERROR
            "Riscrittura dipendenza macOS fallita (${binary}): "
            "${dsdr_change_output}${dsdr_change_error}")
    endif()
endfunction()

# `macdeployqt` aggiorna gli install name delle librerie già copiate nel
# bundle. Il contenuto binario cambia, quindi un confronto SHA-256 non basta
# per riconoscere la stessa libreria dopo tale riscrittura. Il UUID Mach-O,
# invece, resta quello del file di origine: lo usiamo per riusare soltanto la
# copia effettivamente identica, senza nascondere collisioni fra due runtime
# diversi che hanno per caso lo stesso basename.
function(dsdr_same_macho_uuid left right result)
    execute_process(
        COMMAND dwarfdump --uuid "${left}"
        RESULT_VARIABLE dsdr_left_uuid_result
        OUTPUT_VARIABLE dsdr_left_uuid_output
        ERROR_VARIABLE dsdr_left_uuid_error)
    execute_process(
        COMMAND dwarfdump --uuid "${right}"
        RESULT_VARIABLE dsdr_right_uuid_result
        OUTPUT_VARIABLE dsdr_right_uuid_output
        ERROR_VARIABLE dsdr_right_uuid_error)
    if(NOT dsdr_left_uuid_result EQUAL 0 OR NOT dsdr_right_uuid_result EQUAL 0)
        message(FATAL_ERROR
            "Impossibile confrontare gli UUID Mach-O per le dipendenze SoapySDR:\n"
            "  sinistra: ${left} (${dsdr_left_uuid_error})\n"
            "  destra: ${right} (${dsdr_right_uuid_error})")
    endif()

    string(REGEX MATCHALL "UUID: [0-9A-Fa-f-]+" dsdr_left_uuids "${dsdr_left_uuid_output}")
    string(REGEX MATCHALL "UUID: [0-9A-Fa-f-]+" dsdr_right_uuids "${dsdr_right_uuid_output}")
    if(NOT "${dsdr_left_uuids}" STREQUAL ""
       AND "${dsdr_left_uuids}" STREQUAL "${dsdr_right_uuids}")
        set(${result} TRUE PARENT_SCOPE)
    else()
        set(${result} FALSE PARENT_SCOPE)
    endif()
endfunction()

file(MAKE_DIRECTORY "${dsdr_modules}" "${dsdr_frameworks}")
set(dsdr_modules_in_bundle)
foreach(dsdr_source IN LISTS dsdr_sources)
    if(NOT EXISTS "${dsdr_source}")
        message(FATAL_ERROR "Modulo SoapySDR scomparso prima dell'installazione: ${dsdr_source}")
    endif()
    get_filename_component(dsdr_name "${dsdr_source}" NAME)
    set(dsdr_destination "${dsdr_modules}/${dsdr_name}")
    dsdr_copy_binary("${dsdr_source}" "${dsdr_destination}")
    list(APPEND dsdr_modules_in_bundle "${dsdr_destination}")
endforeach()

# Scansioniamo i moduli, non l'app Qt: le librerie risolte comprendono anche
# le dipendenze ricorsive (ad esempio libhackrf -> libusb) e non includono i
# framework QML che macdeployqt ha già sistemato.
file(GET_RUNTIME_DEPENDENCIES
    MODULES ${dsdr_modules_in_bundle}
    RESOLVED_DEPENDENCIES_VAR dsdr_resolved
    UNRESOLVED_DEPENDENCIES_VAR dsdr_unresolved
    DIRECTORIES ${dsdr_runtime_dirs} "${dsdr_frameworks}"
    POST_EXCLUDE_REGEXES "^/System/Library/.*" "^/usr/lib/.*")
if(dsdr_unresolved)
    message(FATAL_ERROR "Dipendenze SoapySDR macOS non risolte: ${dsdr_unresolved}")
endif()

set(dsdr_soapy_framework_binaries)
foreach(dsdr_dependency IN LISTS dsdr_resolved)
    get_filename_component(dsdr_dependency_name "${dsdr_dependency}" NAME)
    set(dsdr_destination "${dsdr_frameworks}/${dsdr_dependency_name}")
    if(EXISTS "${dsdr_destination}")
        file(SHA256 "${dsdr_dependency}" dsdr_source_hash)
        file(SHA256 "${dsdr_destination}" dsdr_destination_hash)
        if(NOT dsdr_source_hash STREQUAL dsdr_destination_hash)
            dsdr_same_macho_uuid("${dsdr_dependency}" "${dsdr_destination}"
                                 dsdr_reuses_macdeployqt_copy)
            # Una corrispondenza UUID prova che macdeployqt ha solo riscritto
            # gli install name della stessa libreria. In tutti gli altri casi
            # fermiamo il pacchetto: due runtime differenti con lo stesso nome
            # renderebbero ambiguo il caricamento dei plugin SoapySDR.
            if(dsdr_reuses_macdeployqt_copy)
                message(STATUS
                    "Reusing macdeployqt's rewritten ${dsdr_dependency_name}")
            else()
                message(FATAL_ERROR
                    "Due dipendenze SoapySDR hanno lo stesso nome ma contenuto diverso: "
                    "${dsdr_dependency_name}\n"
                    "  esistente: ${dsdr_destination}\n"
                    "  richiesta: ${dsdr_dependency}")
            endif()
        endif()
    else()
        dsdr_copy_binary("${dsdr_dependency}" "${dsdr_destination}")
    endif()
    list(APPEND dsdr_soapy_framework_binaries "${dsdr_destination}")
endforeach()

# Non riscriviamo l'intera Contents/Frameworks di Qt: ci limitiamo ai moduli
# Soapy, alle loro dipendenze risolte e all'eseguibile (che può già collegare
# librtlsdr per il backend nativo). Così il bundle resta composabile con il
# deploy di Qt e con eventuali altri step di packaging.
set(dsdr_rewrite_targets
    ${dsdr_modules_in_bundle}
    ${dsdr_soapy_framework_binaries}
    "${dsdr_executable}")
foreach(dsdr_binary IN LISTS dsdr_rewrite_targets)
    if(NOT EXISTS "${dsdr_binary}")
        continue()
    endif()
    execute_process(
        COMMAND otool -L "${dsdr_binary}"
        RESULT_VARIABLE dsdr_otool_result
        OUTPUT_VARIABLE dsdr_otool_output
        ERROR_VARIABLE dsdr_otool_error)
    if(NOT dsdr_otool_result EQUAL 0)
        message(FATAL_ERROR "otool -L fallito per ${dsdr_binary}: ${dsdr_otool_error}")
    endif()
    string(REPLACE "\n" ";" dsdr_otool_lines "${dsdr_otool_output}")
    foreach(dsdr_otool_line IN LISTS dsdr_otool_lines)
        string(STRIP "${dsdr_otool_line}" dsdr_otool_line)
        string(FIND "${dsdr_otool_line}" " (compatibility version " dsdr_compatibility_at)
        if(dsdr_compatibility_at LESS 0)
            continue()
        endif()
        string(SUBSTRING "${dsdr_otool_line}" 0 ${dsdr_compatibility_at} dsdr_old_link)
        get_filename_component(dsdr_link_name "${dsdr_old_link}" NAME)
        set(dsdr_new_target "${dsdr_frameworks}/${dsdr_link_name}")
        if(NOT EXISTS "${dsdr_new_target}")
            continue()
        endif()
        get_filename_component(dsdr_binary_dir "${dsdr_binary}" DIRECTORY)
        file(RELATIVE_PATH dsdr_relative_target "${dsdr_binary_dir}" "${dsdr_new_target}")
        dsdr_change_link("${dsdr_binary}" "${dsdr_old_link}"
                         "@loader_path/${dsdr_relative_target}")
    endforeach()
endforeach()

foreach(dsdr_dependency IN LISTS dsdr_resolved)
    get_filename_component(dsdr_dependency_name "${dsdr_dependency}" NAME)
    set(dsdr_destination "${dsdr_frameworks}/${dsdr_dependency_name}")
    execute_process(
        COMMAND "${dsdr_install_name_tool}" -id "@loader_path/${dsdr_dependency_name}" "${dsdr_destination}"
        RESULT_VARIABLE dsdr_id_result
        OUTPUT_VARIABLE dsdr_id_output
        ERROR_VARIABLE dsdr_id_error)
    if(NOT dsdr_id_result EQUAL 0)
        message(FATAL_ERROR "Riscrittura id macOS fallita: ${dsdr_id_output}${dsdr_id_error}")
    endif()
endforeach()

message(STATUS "Bundled SoapySDR modules: ${dsdr_modules_in_bundle}")
