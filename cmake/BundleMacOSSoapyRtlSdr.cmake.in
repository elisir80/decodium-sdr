# Generated by CMake for the macOS install tree.
# The files are copied from Homebrew at package-build time; no Homebrew path is
# left in the distributed bundle after the install-name rewrite below.

set(dsdr_app "${CMAKE_INSTALL_PREFIX}/decodium-sdr.app")
set(dsdr_frameworks "${dsdr_app}/Contents/Frameworks")
set(dsdr_modules "${dsdr_app}/Contents/PlugIns/SoapySDR/modules0.8")
set(dsdr_module "${dsdr_modules}/librtlsdrSupport.so")
set(dsdr_loader_path "@DSDR_LOADER_PATH@")
set(dsdr_rtlsdr "${dsdr_frameworks}/@DSDR_RTLSDR_BASENAME@")
set(dsdr_libusb "${dsdr_frameworks}/@DSDR_LIBUSB_BASENAME@")

foreach(dsdr_required
        "@DSDR_SOAPY_RTLSDR_MODULE@"
        "@DSDR_LIBRTLSDR_LIBRARY@"
        "@DSDR_LIBUSB_LIBRARY@")
    if(NOT EXISTS "${dsdr_required}")
        message(FATAL_ERROR "Dipendenza RTL-SDR scomparsa prima dell'installazione: ${dsdr_required}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${dsdr_modules}" "${dsdr_frameworks}")

function(dsdr_copy_binary source destination)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${destination}"
        RESULT_VARIABLE dsdr_copy_result
        OUTPUT_VARIABLE dsdr_copy_output
        ERROR_VARIABLE dsdr_copy_error)
    if(NOT dsdr_copy_result EQUAL 0)
        message(FATAL_ERROR
            "Copia della dipendenza macOS fallita (${source} -> ${destination}): "
            "${dsdr_copy_output}${dsdr_copy_error}")
    endif()
endfunction()

dsdr_copy_binary("@DSDR_SOAPY_RTLSDR_MODULE@" "${dsdr_module}")
dsdr_copy_binary("@DSDR_LIBRTLSDR_LIBRARY@" "${dsdr_rtlsdr}")
dsdr_copy_binary("@DSDR_LIBUSB_LIBRARY@" "${dsdr_libusb}")

function(dsdr_rewrite_install_name)
    execute_process(
        COMMAND "@CMAKE_INSTALL_NAME_TOOL@" ${ARGV}
        RESULT_VARIABLE dsdr_name_result
        OUTPUT_VARIABLE dsdr_name_output
        ERROR_VARIABLE dsdr_name_error)
    if(NOT dsdr_name_result EQUAL 0)
        message(FATAL_ERROR
            "Riscrittura install_name macOS fallita: ${dsdr_name_output}${dsdr_name_error}")
    endif()
endfunction()

# The module is three directories below Contents, while the libraries are in
# Contents/Frameworks.
dsdr_rewrite_install_name(
    -change "@DSDR_RTLSDR_SOURCE_NAME@"
             "${dsdr_loader_path}/../../../Frameworks/@DSDR_RTLSDR_BASENAME@"
    -change "@DSDR_SOAPY_SOURCE_NAME@"
             "${dsdr_loader_path}/../../../Frameworks/libSoapySDR.0.8.dylib"
    "${dsdr_module}")

dsdr_rewrite_install_name(
    -id "${dsdr_loader_path}/@DSDR_RTLSDR_BASENAME@"
    -change "@DSDR_LIBUSB_SOURCE_NAME@"
             "${dsdr_loader_path}/@DSDR_LIBUSB_BASENAME@"
    "${dsdr_rtlsdr}")

dsdr_rewrite_install_name(
    -id "${dsdr_loader_path}/@DSDR_LIBUSB_BASENAME@"
    "${dsdr_libusb}")

message(STATUS "Bundled SoapyRTLSDR: ${dsdr_module}")
message(STATUS "Bundled librtlsdr/libusb in: ${dsdr_frameworks}")
