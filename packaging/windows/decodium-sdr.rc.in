// SPDX-License-Identifier: GPL-3.0-or-later
//
// Risorsa dell'eseguibile Windows: icona e scheda «Dettagli» del file.
//
// Senza questa risorsa l'eseguibile mostra l'icona generica di Windows —
// nell'esplora risorse, sulla barra delle applicazioni e nel menu Start — per
// quanto bella sia l'icona che il pacchetto si porta dietro. L'icona di una
// finestra Qt (`setWindowIcon`) è un'altra cosa e non copre quei posti.
//
// Il file lo genera CMake da questo modello: i numeri di versione devono
// venire dal progetto, non essere ricopiati a mano in un secondo posto che
// prima o poi resta indietro.

#include <windows.h>

// Il primo ICON in ordine alfabetico di identificatore è quello che Windows
// usa per il file: essendo l'unico, l'identificatore non ha importanza.
//
// Il percorso è assoluto perché il .rc generato vive nella cartella di build,
// mentre il .ico sta nel repository: un percorso relativo lo cercherebbe
// accanto al file sbagliato.
IDI_APPICON ICON "@DSDR_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0: inglese (Stati Uniti), Unicode. È la coppia che i
        // programmi di sistema cercano per prima; una scheda «Dettagli» in
        // un'altra lingua rischia di restare vuota su una macchina qualsiasi.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DECODIUM"
            VALUE "FileDescription",  "DECODIUM SDR"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "decodium-sdr"
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
            VALUE "OriginalFilename", "decodium-sdr.exe"
            VALUE "ProductName",      "DECODIUM SDR"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
